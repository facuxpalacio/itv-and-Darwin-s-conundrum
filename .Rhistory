aes(x = trait1, y = trait2, fill = density),
alpha = 0.5
) +
scale_fill_gradientn(
colours = c("#0000FF", "#C6DBEF"),
name = "Native"
) +
ggnewscale::new_scale_fill() +
# Invaded
geom_raster(
data = filter(df, habitat == "Invaded", !is.na(quantile)),
aes(x = trait1, y = trait2, fill = density),
alpha = 0.5
) +
scale_fill_gradientn(
colours = c("#FF0000","#FFFF00"),
name = "Invaded"
) +
# Contornos de ambos hábitats
geom_contour(
data = df,
aes(
x = trait1,
y = trait2,
z = quantile,
color = habitat
),
breaks = c(0.25, 0.50, 0.99),
linewidth = 0.65,
na.rm = TRUE
) +
scale_color_manual(
values = c(
"Invaded" = "gray40",
"Native" = "gray40"
)
) +
scale_linetype_manual(
values = c("Native" = "solid", "Invaded" = "dashed"),
guide = "none"
) +
coord_cartesian(
xlim = c(-4, 6),
ylim = c(-4, 4)
) +
labs(
x = "Tree height",
y = "Leaf dry matter content",
color = "Habitat"
) +
theme_classic(base_size = 13) +
theme(
panel.border = element_rect(
colour = "black",
fill = NA,
linewidth = 0.8
),
axis.line = element_blank()
)
